<?xml version="1.0" encoding="UTF-8"?>

<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             version="3.1">

    <persistence-unit name="hazelcastPU"
                      transaction-type="RESOURCE_LOCAL">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.hazlecache.Product</class>

        <properties>

            <!-- MySQL Database Configuration -->
            <property name="jakarta.persistence.jdbc.driver"
                      value="com.mysql.cj.jdbc.Driver"/>

            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mysql://localhost:3306/Hazle_Cache"/>

            <property name="jakarta.persistence.jdbc.user"
                      value="root"/>

            <property name="jakarta.persistence.jdbc.password"
                      value="root"/>

            <!-- Hibernate Configuration -->
            <property name="hibernate.hbm2ddl.auto"
                      value="update"/>

            <property name="hibernate.show_sql"
                      value="true"/>

            <!-- Second-Level Cache -->
            <property name="hibernate.cache.use_second_level_cache"
                      value="true"/>

            <property name="hibernate.cache.region.factory_class"
                      value="jcache"/>

            <!-- Hazelcast JCache Provider -->
            <property name="hibernate.javax.cache.provider"
                      value="com.hazelcast.cache.impl.HazelcastServerCachingProvider"/>

            <property name="hibernate.javax.cache.missing_cache_strategy"
                      value="create"/>

        </properties>

    </persistence-unit>

</persistence>